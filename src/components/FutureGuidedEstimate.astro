---
import { futureContact, futureServices } from '../data/future-content';

const projectTypes = [['New Construction', 'New build'], ['Existing Home', 'Existing home'], ['Attic', 'Attic'], ['Crawlspace', 'Crawlspace'], ['Garage / Shop', 'Garage / shop'], ['Roof', 'Roof'], ['Commercial Property', 'Commercial'], ['Other', 'Other'], ['Not Sure', 'Not sure']];
const goals = [['Insulate new construction', 'New construction'], ['Improve comfort / existing insulation', 'Improve comfort'], ['Replace or remove old insulation', 'Replace old insulation'], ['Insulate an attic or roofline', 'Attic or roofline'], ['Address a crawlspace', 'Crawlspace'], ['Protect / restore a roof', 'Roof restoration'], ['Protect / coat another surface', 'Surface coating'], ['Other', 'Other'], ['Not Sure', 'Not sure']];
const timings = ['ASAP', 'Within 30 days', '1–3 months', '3+ months', 'Just researching'];
const accessOptions = ['No special access', 'Gated community', 'Guard gate', 'Guest / pass approval', 'Call on arrival', 'Other'];
const communities = ['Beaufort', "Lady's Island", 'Hilton Head', 'Bluffton', 'Edisto', 'Hampton County', 'Charleston', 'North Charleston', 'Mount Pleasant', 'Savannah'];
const serviceLabels: Record<string, string> = { 'Open-Cell Spray Foam': 'Open Cell', 'Closed-Cell Spray Foam': 'Closed Cell', 'Fiberglass Batt Insulation': 'Fiberglass Batt', 'Insulation Removal': 'Removal', 'Polyurea Coating': 'Polyurea', 'Spray Foam Roofing': 'Spray Foam Roofing', 'Silicone / Acrylic Roof Coatings': 'Roof Coatings' };
const leadSources = ['Google Search', 'Google Maps / Business Profile', 'Facebook / Instagram', 'Friend / Referral', 'Builder / GC / Realtor', 'Angi', 'BBB', 'Saw our truck / sign', 'Returning customer', 'Other', 'Not sure'];
---
<section class="future-v1__guided-estimate" data-guided-estimate aria-labelledby="guided-estimate-title">
  <header class="future-v1__guided-estimate-intro">
    <p class="future-v1__kicker">Guided estimate</p><h1 id="guided-estimate-title">Tell us about the project.</h1><p>Start with a few simple details. You can go back, make changes, and see a clear request summary before finishing.</p><p class="future-v1__preview-notice" role="note">Interactive preview — nothing entered here is sent yet.</p>
  </header>
  <div class="future-v1__estimate-shell">
    <div class="future-v1__estimate-progress" aria-label="Estimate progress"><p data-progress-copy aria-live="polite">Step 1 of 5 — Your project · Question 1 of 3</p><ol><li data-progress-step="1" aria-current="step"><span>1</span>Project</li><li data-progress-step="2"><span>2</span>Property</li><li data-progress-step="3"><span>3</span>Timing</li><li data-progress-step="4"><span>4</span>Files</li><li data-progress-step="5"><span>5</span>Contact</li></ol></div>
    <form class="future-v1__estimate-form" data-estimate-form novalidate>
      <section data-estimate-step="1" aria-labelledby="estimate-project-title">
        <p class="future-v1__kicker">Step 1</p><h2 id="estimate-project-title" tabindex="-1">Your project</h2><div class="future-v1__project-answer-summaries" data-project-answer-summaries role="group" aria-label="Your project answers"></div>
        <fieldset data-project-question="1"><p class="future-v1__question-count">Question 1 of 3</p><legend tabindex="-1">What are you working on?</legend><p class="future-v1__field-help">Choose the one description that comes closest.</p><div class="future-v1__choice-grid future-v1__choice-grid--compact">{projectTypes.map(([value, label]) => <label class="future-v1__choice"><input type="radio" name="projectType" value={value} /><span>{label}</span></label>)}</div><p class="future-v1__field-error" data-error-for="projectType" aria-live="polite"></p></fieldset>
        <fieldset data-project-question="2" hidden><p class="future-v1__question-count">Question 2 of 3</p><legend tabindex="-1">What are you trying to accomplish?</legend><p class="future-v1__field-help">Choose any that fit. Technical terms are not required.</p><div class="future-v1__choice-grid future-v1__choice-grid--compact">{goals.map(([value, label]) => <label class="future-v1__choice"><input type="checkbox" name="goals" value={value} data-not-sure={value === 'Not Sure' ? 'true' : undefined} /><span>{label}</span></label>)}</div></fieldset>
        <fieldset data-project-question="3" hidden><p class="future-v1__question-count">Question 3 of 3</p><legend tabindex="-1">Do you already know which service you are interested in?</legend><p class="future-v1__field-help">Choose any services you want to discuss, or choose Not Sure.</p><div class="future-v1__choice-grid future-v1__choice-grid--compact">{futureServices.map((service) => <label class="future-v1__choice"><input type="checkbox" name="services" value={service.title} /><span>{serviceLabels[service.title] ?? service.title}</span></label>)}<label class="future-v1__choice"><input type="checkbox" name="services" value="Not Sure" data-not-sure="true" /><span>Not sure</span></label></div></fieldset>
      </section>
      <section data-estimate-step="2" hidden aria-labelledby="estimate-property-title">
        <p class="future-v1__kicker">Step 2</p><h2 id="estimate-property-title" tabindex="-1">Property &amp; access</h2><div class="future-v1__field-grid"><label>City or community <span aria-hidden="true">*</span><input name="city" autocomplete="address-level2" list="future-community-list" maxlength="100" /><small>Required. A community name is welcome if that is how you know the area.</small><span class="future-v1__field-error" data-error-for="city" aria-live="polite"></span></label><label>ZIP code <span aria-hidden="true">*</span><input name="zip" inputmode="numeric" autocomplete="postal-code" maxlength="5" /><small>Required.</small><span class="future-v1__field-error" data-error-for="zip" aria-live="polite"></span></label><label>Street address <span class="future-v1__optional">Optional</span><input name="street" autocomplete="street-address" maxlength="140" /><span class="future-v1__field-error" data-error-for="street" aria-live="polite"></span></label><label>Community or subdivision <span class="future-v1__optional">Optional</span><input name="subdivision" maxlength="100" /><span class="future-v1__field-error" data-error-for="subdivision" aria-live="polite"></span></label></div><datalist id="future-community-list">{communities.map((community) => <option value={community} />)}</datalist><p class="future-v1__area-note" data-area-note hidden role="status">This may be outside our normal service area, but East Coast Foam can still review the project.</p><fieldset><legend>Will we need special access to reach the property?</legend><div class="future-v1__choice-grid future-v1__choice-grid--compact">{accessOptions.map((choice, index) => <label class="future-v1__choice"><input type="radio" name="access" value={choice} checked={index === 0} /><span>{choice}</span></label>)}</div><p class="future-v1__field-help future-v1__access-note" data-access-note hidden>East Coast Foam can confirm gate codes, guest-list, or pass details before the visit.</p></fieldset>
      </section>
      <section data-estimate-step="3" hidden aria-labelledby="estimate-timing-title">
        <p class="future-v1__kicker">Step 3</p><h2 id="estimate-timing-title" tabindex="-1">Timing &amp; details</h2><fieldset><legend>When are you hoping to get started?</legend><div class="future-v1__choice-grid future-v1__choice-grid--compact">{timings.map((choice) => <label class="future-v1__choice"><input type="radio" name="timing" value={choice} /><span>{choice}</span></label>)}</div><p class="future-v1__field-error" data-error-for="timing" aria-live="polite"></p></fieldset><label class="future-v1__full-field">Approximate project size <span class="future-v1__optional">If known · square feet</span><input name="size" inputmode="decimal" maxlength="20" placeholder="For example: 1,500" /><span class="future-v1__field-error" data-error-for="size" aria-live="polite"></span><small class="future-v1__field-warning" data-size-warning hidden></small></label><label class="future-v1__full-field">Anything else we should know about the project? <span class="future-v1__optional">Optional</span><textarea name="notes" rows="4" maxlength="1200" placeholder="Access, existing conditions, or anything you would like to discuss."></textarea><span class="future-v1__field-error" data-error-for="notes" aria-live="polite"></span></label><a class="future-v1__estimate-callout" data-asap-call hidden href={`tel:${futureContact.phoneHref}`}><span aria-hidden="true">☎</span><span>Call East Coast Foam</span><strong>{futureContact.phoneDisplay}</strong></a>
      </section>
      <section data-estimate-step="4" hidden aria-labelledby="estimate-files-title">
        <p class="future-v1__kicker">Step 4</p><h2 id="estimate-files-title" tabindex="-1">Photos &amp; plans</h2><p class="future-v1__step-copy">Optional photos and PDFs can help provide context. Files remain on this device in this preview.</p><div class="future-v1__upload-grid"><label class="future-v1__upload-card"><input type="file" name="photos" accept="image/jpeg,image/png,image/webp,image/heic" multiple data-photo-input /><span aria-hidden="true">▧</span><strong>Choose photos</strong><small>Pick existing gallery or project photos. Up to 10 images.</small></label><label class="future-v1__upload-card future-v1__upload-card--camera"><input type="file" name="cameraPhoto" accept="image/jpeg,image/png,image/webp,image/heic" capture="environment" data-camera-input /><span aria-hidden="true">◉</span><strong>Take photo</strong><small>Use the camera when a new jobsite photo is more useful.</small></label><label class="future-v1__upload-card"><input type="file" name="plans" accept="application/pdf" multiple data-document-input /><span aria-hidden="true">PDF</span><strong>Add plans or PDFs</strong><small>Up to 3 PDFs, such as floor plans, site plans, roof reports, or sketches.</small></label></div><p class="future-v1__file-status" data-file-status role="status">No files selected.</p><div class="future-v1__file-list" data-file-list aria-live="polite"></div>
      </section>
      <section data-estimate-step="5" hidden aria-labelledby="estimate-contact-title">
        <p class="future-v1__kicker">Step 5</p><h2 id="estimate-contact-title" tabindex="-1">How should East Coast Foam reach you?</h2><div class="future-v1__field-grid"><label>Full name <span aria-hidden="true">*</span><input name="fullName" autocomplete="name" maxlength="120" /><span class="future-v1__field-error" data-error-for="fullName" aria-live="polite"></span></label><label>Phone <span aria-hidden="true">*</span><input name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="18" placeholder="(843) 263-4933" /><span class="future-v1__field-error" data-error-for="phone" aria-live="polite"></span></label></div><div class="future-v1__extension-row"><button type="button" data-add-extension>+ Add extension</button><label data-extension-field hidden>Ext. <input name="extension" inputmode="numeric" autocomplete="tel-extension" maxlength="6" /><span class="future-v1__field-error" data-error-for="extension" aria-live="polite"></span><button type="button" data-remove-extension>Remove extension</button></label></div><div class="future-v1__field-grid"><label>Email <span class="future-v1__optional">Required if Email is preferred</span><input name="email" type="email" autocomplete="email" maxlength="254" /><span class="future-v1__field-error" data-error-for="email" aria-live="polite"></span></label><label>Best time to reach you <span class="future-v1__optional">Optional</span><input name="bestTime" maxlength="100" placeholder="For example: weekday afternoons" /><span class="future-v1__field-error" data-error-for="bestTime" aria-live="polite"></span></label></div><fieldset><legend>Preferred contact <span aria-hidden="true">*</span></legend><div class="future-v1__choice-grid future-v1__choice-grid--compact">{['Call', 'Text', 'Email'].map((choice) => <label class="future-v1__choice"><input type="radio" name="contactPreference" value={choice} /><span>{choice}</span></label>)}</div><p class="future-v1__field-error" data-error-for="contactPreference" aria-live="polite"></p><p class="future-v1__field-help" data-text-preference-note hidden>Text preference is noted for a future contact experience. Consent details will be confirmed before texting is enabled.</p></fieldset><label class="future-v1__full-field future-v1__source-field">How did you hear about East Coast Foam? <span class="future-v1__optional">Optional</span><select name="leadSource"><option value="">Choose one if you’d like</option>{leadSources.map((source) => <option value={source}>{source}</option>)}</select></label><div class="future-v1__lead-source-followup" data-lead-source-followup hidden aria-live="polite"><p data-lead-source-message></p><label data-lead-source-field hidden><span data-lead-source-label></span> <span class="future-v1__optional">Optional</span><input name="leadSourceDetail" maxlength="100" /><span class="future-v1__field-error" data-error-for="leadSourceDetail" aria-live="polite"></span></label></div>
      </section>
      <div class="future-v1__estimate-controls" data-estimate-controls><button class="future-v1__control-button future-v1__control-button--secondary" type="button" data-back hidden>Back</button><button class="future-v1__control-button" type="button" data-next>Continue</button></div>
    </form>
    <section class="future-v1__estimate-review" data-estimate-review hidden aria-labelledby="estimate-review-title"><p class="future-v1__kicker">Review request</p><h2 id="estimate-review-title" tabindex="-1">Make sure this looks right.</h2><p>Nothing is sent in this preview. Edit any section before you finish.</p><div class="future-v1__review-groups"><article><div><span aria-hidden="true">⌂</span><h3>Project</h3><button type="button" data-edit-step="1">Edit</button></div><p data-review-project></p></article><article><div><span aria-hidden="true">⌖</span><h3>Property</h3><button type="button" data-edit-step="2">Edit</button></div><p data-review-property></p></article><article><div><span aria-hidden="true">◷</span><h3>Timing</h3><button type="button" data-edit-step="3">Edit</button></div><p data-review-timing></p></article><article><div><span aria-hidden="true">▧</span><h3>Photos &amp; plans</h3><button type="button" data-edit-step="4">Edit</button></div><p data-review-files></p></article><article><div><span aria-hidden="true">☎</span><h3>Contact</h3><button type="button" data-edit-step="5">Edit</button></div><p data-review-contact></p></article></div><div class="future-v1__estimate-controls"><button class="future-v1__control-button future-v1__control-button--secondary" type="button" data-review-back>Back</button><button class="future-v1__control-button" type="button" data-finish-preview>Finish Preview</button></div></section>
    <section class="future-v1__estimate-receipt" data-estimate-receipt hidden aria-labelledby="estimate-receipt-title" tabindex="-1"><p class="future-v1__kicker">Preview complete</p><h2 id="estimate-receipt-title">What East Coast Foam would receive</h2><p class="future-v1__receipt-intro">Your request remains on this device in this interactive preview.</p><div class="future-v1__receipt-card" data-owner-receipt></div><aside class="future-v1__scheduling-teaser"><div><p class="future-v1__kicker">Next step</p><h3>Schedule a Site Evaluation</h3><p>Online scheduling could appear here after East Coast Foam reviews the project.</p></div><span>Future option</span></aside><button class="future-v1__control-button future-v1__control-button--secondary" type="button" data-start-over>Start another preview</button></section>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-guided-estimate]'); if (!root) throw new Error('Guided estimate root was not found.');
  const form = root.querySelector<HTMLFormElement>('[data-estimate-form]')!; const steps = [...root.querySelectorAll<HTMLElement>('[data-estimate-step]')]; const review = root.querySelector<HTMLElement>('[data-estimate-review]')!; const receipt = root.querySelector<HTMLElement>('[data-estimate-receipt]')!; const progressCopy = root.querySelector<HTMLElement>('[data-progress-copy]')!; const back = root.querySelector<HTMLButtonElement>('[data-back]')!; const next = root.querySelector<HTMLButtonElement>('[data-next]')!; const fileList = root.querySelector<HTMLElement>('[data-file-list]')!; const fileStatus = root.querySelector<HTMLElement>('[data-file-status]')!; const photoInput = root.querySelector<HTMLInputElement>('[data-photo-input]')!; const cameraInput = root.querySelector<HTMLInputElement>('[data-camera-input]')!; const documentInput = root.querySelector<HTMLInputElement>('[data-document-input]')!; const cityInput = form.elements.namedItem('city') as HTMLInputElement; const phoneInput = form.elements.namedItem('phone') as HTMLInputElement; const sizeInput = form.elements.namedItem('size') as HTMLInputElement; const extensionInput = form.elements.namedItem('extension') as HTMLInputElement;
  const knownCommunities = ['beaufort', "lady's island", 'hilton head', 'bluffton', 'edisto', 'hampton county', 'charleston', 'north charleston', 'mount pleasant', 'savannah']; const stepNames = ['Your project', 'Property & access', 'Timing & details', 'Photos & plans', 'Contact']; let currentStep = 1; let currentProjectQuestion = 1; let files: Array<{ id: string; kind: 'photo' | 'document'; name: string; size: number; url?: string }> = [];
  const values = (name: string) => [...form.querySelectorAll<HTMLInputElement>(`[name="${name}"]:checked`)].map((input) => input.value); const value = (name: string) => ((form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value ?? '').trim(); const formatSize = (size: number) => size < 1024 * 1024 ? `${Math.max(1, Math.round(size / 1024))} KB` : `${(size / 1024 / 1024).toFixed(1)} MB`; const cleanText = (input: string) => input.trim().replace(/[\u0000-\u001F\u007F]/g, '');
  const error = (name: string, message = '') => { const field = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`); if (field) field.textContent = message; [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`[name="${name}"]`)].forEach((control) => control.setAttribute('aria-invalid', message ? 'true' : 'false')); }; const firstError = () => form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
  const normalizedPhone = (input: string) => { const digits = input.replace(/\D/g, ''); if (digits.length === 11 && digits.startsWith('1')) return digits.slice(1); return digits.length === 10 ? digits : null; }; const phoneDisplay = (input: string) => { const digits = input.replace(/\D/g, '').replace(/^1(?=\d{10}$)/, '').slice(0, 10); if (digits.length < 4) return digits ? `(${digits}` : ''; if (digits.length < 7) return `(${digits.slice(0, 3)}) ${digits.slice(3)}`; return `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`; };
  const normalArea = () => { const city = cityInput.value.trim().toLowerCase(); root.querySelector<HTMLElement>('[data-area-note]')!.hidden = !city || knownCommunities.some((community) => city.includes(community) || community.includes(city)); }; const accessNote = () => { const selected = values('access')[0]; root.querySelector<HTMLElement>('[data-access-note]')!.hidden = !selected || selected === 'No special access'; };
  const toggleExclusiveNotSure = (target: HTMLInputElement) => { const named = [...form.querySelectorAll<HTMLInputElement>(`[name="${target.name}"]`)]; const notSure = named.find((item) => item.dataset.notSure === 'true' || item.value === 'Not Sure'); if (!notSure) return; if (target === notSure && target.checked) named.filter((item) => item !== target).forEach((item) => item.checked = false); if (target !== notSure && target.checked) notSure.checked = false; };
  const labelFor = (items: string[], labels: Record<string, string> = {}) => items.filter((item) => item !== 'Not Sure').map((item) => labels[item] ?? item); const projectSummary = () => { const project = values('projectType')[0]; const selectedGoals = values('goals'); const selectedServices = values('services'); if (project === 'Not Sure' && (!selectedGoals.length || selectedGoals[0] === 'Not Sure') && (!selectedServices.length || selectedServices[0] === 'Not Sure')) return 'Not sure yet — East Coast Foam can help identify the right approach.'; const pieces = [project && project !== 'Not Sure' ? project : '', ...labelFor(selectedGoals), ...labelFor(selectedServices, { 'Open-Cell Spray Foam': 'Open Cell', 'Closed-Cell Spray Foam': 'Closed Cell', 'Fiberglass Batt Insulation': 'Fiberglass Batt', 'Insulation Removal': 'Removal', 'Polyurea Coating': 'Polyurea', 'Spray Foam Roofing': 'Spray Foam Roofing', 'Silicone / Acrylic Roof Coatings': 'Roof Coatings' })].filter(Boolean); return pieces.length ? pieces.join(' · ') : 'Not sure yet — East Coast Foam can help identify the right approach.'; };
  const renderProjectSummaries = () => { const container = root.querySelector<HTMLElement>('[data-project-answer-summaries]')!; container.replaceChildren(); const summaries: Array<[number, string, string]> = [[1, 'Project', values('projectType')[0] ?? ''], [2, 'Goal', labelFor(values('goals')).join(', ') || (values('goals')[0] === 'Not Sure' ? 'Not sure' : '')]]; summaries.filter(([question, , answer]) => question < currentProjectQuestion && answer).forEach(([question, label, answer]) => { const button = document.createElement('button'); button.type = 'button'; button.dataset.projectEdit = String(question); button.innerHTML = `<strong>${label}</strong><span>${answer}</span><i>Edit</i>`; button.addEventListener('click', () => setProjectQuestion(question)); container.append(button); }); };
  const renderFiles = () => { fileList.replaceChildren(); const photos = files.filter((file) => file.kind === 'photo'); const documents = files.filter((file) => file.kind === 'document'); fileStatus.textContent = files.length ? `${photos.length} ${photos.length === 1 ? 'photo' : 'photos'} and ${documents.length} ${documents.length === 1 ? 'PDF' : 'PDFs'} selected. Files remain only in this browser preview.` : 'No files selected.'; files.forEach((file) => { const item = document.createElement('article'); item.className = `future-v1__selected-file future-v1__selected-file--${file.kind}`; if (file.kind === 'photo' && file.url) { const image = document.createElement('img'); image.src = file.url; image.alt = `Selected project photo: ${file.name}`; item.append(image); } else { const icon = document.createElement('span'); icon.setAttribute('aria-hidden', 'true'); icon.textContent = 'PDF'; item.append(icon); } const copy = document.createElement('div'); const name = document.createElement('strong'); name.textContent = file.name; name.title = file.name; const meta = document.createElement('small'); meta.textContent = `${file.kind === 'photo' ? 'Photo' : 'PDF document'} · ${formatSize(file.size)}`; copy.append(name, meta); const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = `Remove ${file.name}`; remove.addEventListener('click', () => { if (file.url) URL.revokeObjectURL(file.url); files = files.filter((item) => item.id !== file.id); renderFiles(); }); item.append(copy, remove); fileList.append(item); }); };
  const addFiles = (selected: FileList | null, kind: 'photo' | 'document') => { if (!selected) return; const limit = kind === 'photo' ? 10 : 3; const existing = files.filter((file) => file.kind === kind).length; const valid = [...selected].filter((file) => kind === 'photo' ? file.type.startsWith('image/') : file.type === 'application/pdf'); const accepted = valid.slice(0, Math.max(0, limit - existing)); files.push(...accepted.map((file, index) => ({ id: `${Date.now()}-${index}-${file.name}`, kind, name: file.name, size: file.size, url: kind === 'photo' ? URL.createObjectURL(file) : undefined }))); renderFiles(); const rejected = selected.length - accepted.length; if (rejected) fileStatus.textContent += ` ${rejected} file${rejected === 1 ? ' was' : 's were'} not added because only ${kind === 'photo' ? 'images (up to 10)' : 'PDFs (up to 3)'} are accepted.`; };
  const normalizedSize = () => value('size').replace(/[\s,]/g, ''); const renderSizeWarning = () => { const warning = root.querySelector<HTMLElement>('[data-size-warning]')!; const size = normalizedSize(); const numeric = Number(size); warning.hidden = !size || !Number.isFinite(numeric) || numeric <= 0 || (numeric >= 100 && numeric <= 100000); warning.textContent = !warning.hidden ? 'That size looks unusual. You can continue; East Coast Foam can confirm the project details.' : ''; };
  const validateText = (name: string, minimum: number, maximum: number, message: string, requireLetter = false) => { const text = cleanText(value(name)); const invalid = !text || text.length < minimum || text.length > maximum || /^\d+$/.test(text) || (requireLetter && !/\p{L}/u.test(text)); if (invalid) error(name, message); };
  const validateStep = (step: number) => { ['projectType', 'city', 'zip', 'street', 'subdivision', 'timing', 'size', 'notes', 'fullName', 'phone', 'extension', 'email', 'bestTime', 'contactPreference', 'leadSourceDetail'].forEach((name) => error(name)); if (step === 1 && currentProjectQuestion === 1 && !values('projectType')[0]) error('projectType', 'Choose what you are working on to continue.'); if (step === 2) { validateText('city', 2, 100, 'Enter a useful city or community name to continue.', true); if (!/^\d{5}$/.test(value('zip'))) error('zip', 'Enter a 5-digit ZIP code.'); } if (step === 3) { if (!values('timing')[0]) error('timing', 'Choose a timing option to continue.'); const size = normalizedSize(); if (size && (!/^\d+(?:\.\d+)?$/.test(size) || Number(size) <= 0)) error('size', 'Enter a numeric square-foot estimate, if known.'); if (value('notes').length > 1200) error('notes', 'Please shorten the notes to 1,200 characters.'); } if (step === 5) { validateText('fullName', 2, 120, 'Enter a full name with at least two meaningful characters.', true); if (!normalizedPhone(value('phone'))) error('phone', 'Enter a 10-digit U.S. phone number.'); if (value('extension') && !/^\d{1,6}$/.test(value('extension'))) error('extension', 'Use up to 6 digits for an extension.'); const preference = values('contactPreference')[0]; if (!preference) error('contactPreference', 'Choose how you prefer to be contacted.'); const email = value('email'); if (preference === 'Email' && (!email || email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))) error('email', 'Enter a valid email address when Email is preferred.'); if (value('bestTime').length > 100) error('bestTime', 'Please shorten the best-time note.'); if (value('leadSourceDetail').length > 100) error('leadSourceDetail', 'Please shorten this note.'); } return !form.querySelector('[aria-invalid="true"]'); };
  const positionActive = (target: HTMLElement) => { target.focus({ preventScroll: true }); requestAnimationFrame(() => target.scrollIntoView({ block: 'start', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })); };
  const setProjectQuestion = (question: number, focus = true) => { currentProjectQuestion = question; steps[0].querySelectorAll<HTMLElement>('[data-project-question]').forEach((field) => field.hidden = Number(field.dataset.projectQuestion) !== question); renderProjectSummaries(); progressCopy.textContent = `Step 1 of 5 — Your project · Question ${question} of 3`; back.hidden = question === 1; if (focus) positionActive(steps[0].querySelector<HTMLElement>(`[data-project-question="${question}"] legend`) ?? steps[0].querySelector<HTMLElement>('h2')!); };
  const setStep = (step: number, focus = true) => { currentStep = step; review.hidden = true; receipt.hidden = true; form.hidden = false; steps.forEach((section) => section.hidden = Number(section.dataset.estimateStep) !== step); root.querySelectorAll<HTMLElement>('[data-progress-step]').forEach((item) => { const isCurrent = Number(item.dataset.progressStep) === step; item.toggleAttribute('aria-current', isCurrent); item.classList.toggle('is-complete', Number(item.dataset.progressStep) < step); }); if (step === 1) { setProjectQuestion(currentProjectQuestion, focus); return; } progressCopy.textContent = `Step ${step} of 5 — ${stepNames[step - 1]}`; back.hidden = false; next.textContent = step === 5 ? 'Review Request' : 'Continue'; if (focus) positionActive(steps[step - 1].querySelector<HTMLElement>('h2')!); };
  const summary = (selector: string, text: string) => { const item = root.querySelector<HTMLElement>(selector); if (item) item.textContent = text; }; const contactSummary = () => [value('fullName'), phoneDisplay(value('phone')), value('extension') && `Ext. ${value('extension')}`, value('email'), values('contactPreference')[0] && `Prefers ${values('contactPreference')[0].toLowerCase()}`, value('bestTime'), value('leadSource'), value('leadSourceDetail') && `${value('leadSource')}: ${value('leadSourceDetail')}`].filter(Boolean).join(' · ');
  const renderReview = () => { const property = [value('city'), value('zip'), value('subdivision'), values('access')[0] && values('access')[0] !== 'No special access' ? `${values('access')[0]} access` : 'No special access'].filter(Boolean).join(' · '); const timing = [values('timing')[0], value('size') && `Approx. ${value('size')} sq ft`, value('notes')].filter(Boolean).join(' · '); const photos = files.filter((file) => file.kind === 'photo'); const documents = files.filter((file) => file.kind === 'document'); const attachments = [photos.length ? `${photos.length} project photo${photos.length === 1 ? '' : 's'}` : '', documents.length ? `${documents.length} PDF${documents.length === 1 ? '' : 's'}: ${documents.map((file) => file.name).join(', ')}` : ''].filter(Boolean).join(' · ') || 'No photos or plans selected.'; summary('[data-review-project]', projectSummary()); summary('[data-review-property]', property); summary('[data-review-timing]', timing || 'No additional details selected.'); summary('[data-review-files]', attachments); summary('[data-review-contact]', contactSummary()); };
  const showReview = () => { renderReview(); form.hidden = true; review.hidden = false; positionActive(review.querySelector<HTMLElement>('h2')!); }; const finishPreview = () => { const ownerReceipt = root.querySelector<HTMLElement>('[data-owner-receipt]')!; ownerReceipt.replaceChildren(); const photos = files.filter((file) => file.kind === 'photo'); const documents = files.filter((file) => file.kind === 'document'); const lines = [projectSummary(), [value('city'), value('subdivision'), values('access')[0] && values('access')[0] !== 'No special access' ? `${values('access')[0]} access` : 'No special access'].filter(Boolean).join(' · '), values('timing')[0], `${photos.length} project photo${photos.length === 1 ? '' : 's'} · ${documents.length} PDF document${documents.length === 1 ? '' : 's'}`, contactSummary()]; lines.filter(Boolean).forEach((line) => { const p = document.createElement('p'); p.textContent = line; ownerReceipt.append(p); }); form.hidden = true; review.hidden = true; receipt.hidden = false; positionActive(receipt); };
  const leadSourceFollowups: Record<string, { message: string; label?: string }> = { 'Google Search': { message: 'What did you search for?', label: 'What did you search for?' }, 'Google Maps / Business Profile': { message: 'Thanks for finding us on Google Maps.' }, 'Facebook / Instagram': { message: 'Thanks for following along. Was there something you saw that made you reach out?', label: 'What caught your attention?' }, 'Friend / Referral': { message: 'We appreciate the introduction.', label: 'Who can we thank?' }, 'Builder / GC / Realtor': { message: 'Thanks for the context.', label: 'Who are you working with?' }, Angi: { message: 'Thanks for finding East Coast Foam through Angi.' }, BBB: { message: 'Thanks for checking East Coast Foam on BBB.' }, 'Saw our truck / sign': { message: 'It is helpful to know where you saw us.', label: 'Where did you see us?' }, 'Returning customer': { message: 'Welcome back — we appreciate the opportunity to serve you again.' }, Other: { message: 'Thanks for letting us know.', label: 'How did you hear about us?' }, 'Not sure': { message: 'No problem — you can leave this blank.' } };
  const renderLeadSourceFollowup = () => { const source = value('leadSource'); const config = leadSourceFollowups[source]; const panel = root.querySelector<HTMLElement>('[data-lead-source-followup]')!; const message = root.querySelector<HTMLElement>('[data-lead-source-message]')!; const field = root.querySelector<HTMLElement>('[data-lead-source-field]')!; const label = root.querySelector<HTMLElement>('[data-lead-source-label]')!; const input = form.elements.namedItem('leadSourceDetail') as HTMLInputElement; panel.hidden = !config; message.textContent = config?.message ?? ''; field.hidden = !config?.label; label.textContent = config?.label ?? ''; if (!config?.label) { input.value = ''; error('leadSourceDetail'); } };
  const setExtensionVisible = (visible: boolean) => { const field = root.querySelector<HTMLElement>('[data-extension-field]')!; const add = root.querySelector<HTMLButtonElement>('[data-add-extension]')!; field.hidden = !visible; add.hidden = visible; if (!visible) { extensionInput.value = ''; error('extension'); } else extensionInput.focus(); };
  form.addEventListener('submit', (event) => event.preventDefault()); form.addEventListener('change', (event) => { const target = event.target; if (target instanceof HTMLInputElement && (target.name === 'services' || target.name === 'goals')) toggleExclusiveNotSure(target); if (target instanceof HTMLInputElement && target.name === 'access') accessNote(); if (target instanceof HTMLInputElement && target.name === 'timing') root.querySelector<HTMLElement>('[data-asap-call]')!.hidden = target.value !== 'ASAP'; if (target instanceof HTMLInputElement && target.name === 'contactPreference') root.querySelector<HTMLElement>('[data-text-preference-note]')!.hidden = target.value !== 'Text'; if (target instanceof HTMLSelectElement && target.name === 'leadSource') renderLeadSourceFollowup(); renderProjectSummaries(); });
  cityInput.addEventListener('input', normalArea); phoneInput.addEventListener('input', () => { phoneInput.value = phoneDisplay(phoneInput.value); }); extensionInput.addEventListener('input', () => { extensionInput.value = extensionInput.value.replace(/\D/g, '').slice(0, 6); }); sizeInput.addEventListener('input', renderSizeWarning); root.querySelector<HTMLButtonElement>('[data-add-extension]')!.addEventListener('click', () => setExtensionVisible(true)); root.querySelector<HTMLButtonElement>('[data-remove-extension]')!.addEventListener('click', () => setExtensionVisible(false)); photoInput.addEventListener('change', () => { addFiles(photoInput.files, 'photo'); photoInput.value = ''; }); cameraInput.addEventListener('change', () => { addFiles(cameraInput.files, 'photo'); cameraInput.value = ''; }); documentInput.addEventListener('change', () => { addFiles(documentInput.files, 'document'); documentInput.value = ''; });
  next.addEventListener('click', () => { if (!validateStep(currentStep)) { firstError(); return; } if (currentStep === 1 && currentProjectQuestion < 3) { setProjectQuestion(currentProjectQuestion + 1); return; } if (currentStep === 5) { showReview(); return; } setStep(currentStep + 1); }); back.addEventListener('click', () => { if (currentStep === 1 && currentProjectQuestion > 1) setProjectQuestion(currentProjectQuestion - 1); else if (currentStep > 1) { if (currentStep === 2) currentProjectQuestion = 3; setStep(currentStep - 1); } }); root.querySelectorAll<HTMLButtonElement>('[data-edit-step]').forEach((button) => button.addEventListener('click', () => { if (Number(button.dataset.editStep) === 1) currentProjectQuestion = 1; setStep(Number(button.dataset.editStep)); })); root.querySelector<HTMLButtonElement>('[data-review-back]')!.addEventListener('click', () => setStep(5)); root.querySelector<HTMLButtonElement>('[data-finish-preview]')!.addEventListener('click', finishPreview); root.querySelector<HTMLButtonElement>('[data-start-over]')!.addEventListener('click', () => { files.forEach((file) => file.url && URL.revokeObjectURL(file.url)); files = []; form.reset(); setExtensionVisible(false); root.querySelector<HTMLElement>('[data-lead-source-followup]')!.hidden = true; root.querySelector<HTMLElement>('[data-text-preference-note]')!.hidden = true; root.querySelector<HTMLElement>('[data-asap-call]')!.hidden = true; currentProjectQuestion = 1; renderFiles(); renderSizeWarning(); accessNote(); setStep(1); }); window.addEventListener('pagehide', () => files.forEach((file) => file.url && URL.revokeObjectURL(file.url)), { once: true }); renderFiles(); renderProjectSummaries(); renderSizeWarning(); accessNote(); renderLeadSourceFollowup(); setExtensionVisible(false); setProjectQuestion(1, false);
</script>
