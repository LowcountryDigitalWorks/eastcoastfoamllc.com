---
import home from '../data/classical-home.json';
import assets from '../data/demo-assets.json';
---
<section class="future-v1__about" id="about" aria-labelledby="future-about-title">
  <div class="future-v1__about-photo"><img src={assets.serviceImages['insulation-removal-services']} alt="East Coast Foam insulation work" loading="lazy" referrerpolicy="no-referrer" /></div>
  <div>
    <p class="future-v1__kicker">Why East Coast Foam</p>
    <h2 id="future-about-title">Local expertise. Direct accountability.</h2>
    <p class="future-v1__lede">{home.about}</p>
    <div class="future-v1__about-points">
      {home.whyChoose.slice(0, 3).map((point, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{point.title}</h3><p>{point.text}</p></article>)}
    </div>
  </div>
</section>
