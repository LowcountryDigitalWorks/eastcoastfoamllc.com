---
import assets from '../data/demo-assets.json';
import { futureAboutPoints } from '../data/future-content';
---
<section class="future-v1__about" id="about" aria-labelledby="future-about-title">
  <figure class="future-v1__about-photo">
    <img src={assets.companyVehicle} alt="East Coast Foam truck and branded insulation trailer" loading="lazy" referrerpolicy="no-referrer" />
    <figcaption><span>East Coast Foam</span> Recognizable on the road and at the jobsite.</figcaption>
  </figure>
  <div>
    <p class="future-v1__kicker">Why East Coast Foam</p>
    <h2 id="future-about-title">Local expertise. Direct accountability.</h2>
    <p class="future-v1__lede">East Coast Foam is a locally owned and operated company. The work starts with the property, its accessible conditions, and the customer’s goals.</p>
    <div class="future-v1__about-points">
      {futureAboutPoints.map((point, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{point.title}</h3><p>{point.text}</p></article>)}
    </div>
  </div>
</section>
