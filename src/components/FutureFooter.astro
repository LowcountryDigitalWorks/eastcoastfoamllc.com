---
import BrandMark from './BrandMark.astro';
import { futureContact, futureServices } from '../data/future-content';
---
<footer class="future-v1__footer">
  <div class="future-v1__footer-main"><div><BrandMark href="/future" /><p>Spray foam, insulation, roofing, and coating services for the Lowcountry and Coastal Georgia.</p><a class="future-v1__footer-facebook" href={futureContact.facebook} target="_blank" rel="noopener noreferrer">Facebook <span aria-hidden="true">↗</span></a></div><div><h2>Contact</h2><a href={`tel:${futureContact.phoneHref}`}>{futureContact.phoneDisplay}</a><a href={`mailto:${futureContact.publicEmail}`}>{futureContact.publicEmail}</a><a href="/future/contact">Contact &amp; save contact</a><a href={futureContact.mapsUrl} target="_blank" rel="noopener noreferrer">{futureContact.address}</a><span>{futureContact.hours}</span></div><div><h2>Services</h2>{futureServices.map((service) => <a href={service.futurePath}>{service.title}</a>)}</div><div><h2>Explore</h2><a href="/future/projects">Projects</a><a href="/future/about">About</a><a href="/future/reviews">Reviews</a><a href="/future/service-area">Service Area</a><a href="/future/resources">Guides</a><a href="/future/contact">Contact</a><a class="future-v1__footer-estimate" href="/future/estimate">Request an Estimate <span aria-hidden="true">→</span></a></div></div>
  <div class="future-v1__footer-bottom"><span>© {new Date().getFullYear()} East Coast Foam LLC</span><span>South Carolina Lowcountry &amp; Coastal Georgia</span></div>
</footer>
