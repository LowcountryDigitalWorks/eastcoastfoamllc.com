---
import BrandMark from './BrandMark.astro';
import site from '../data/site.json';
import services from '../data/services.json';
---
<footer class="future-v1__footer">
  <div class="future-v1__footer-main"><div><BrandMark href="#top" /><p>Spray foam, insulation, roofing, and coating services for the Lowcountry and Coastal Georgia.</p><a class="future-v1__footer-facebook" href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook <span aria-hidden="true">↗</span></a></div><div><h2>Contact</h2><a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a><a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a><a href={site.mapsUrl} target="_blank" rel="noopener noreferrer">{site.address}</a><span>{site.hours}</span></div><div><h2>Services</h2>{services.map((service) => <a href={`/classical/${service.slug}`}>{service.title}</a>)}</div><div><h2>Explore</h2><a href="#projects">Projects</a><a href="#about">About</a><a href="#reviews">Reviews</a><a href="#service-area">Service Area</a><a href="#resources">Resources</a><a class="future-v1__footer-estimate" href="#estimate">Request an Estimate <span aria-hidden="true">→</span></a></div></div>
  <div class="future-v1__footer-bottom"><span>© {new Date().getFullYear()} East Coast Foam LLC</span><span>South Carolina Lowcountry &amp; Coastal Georgia</span></div>
</footer>
