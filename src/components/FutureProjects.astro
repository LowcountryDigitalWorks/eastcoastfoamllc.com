---
import assets from '../data/demo-assets.json';
import { currentPublicProjects } from '../data/future-projects';

const work = [
  { title: 'Open-cell spray foam', image: assets.serviceImages['open-cell-spray-foam-insulation'], href: '/future/open-cell-spray-foam-insulation' },
  { title: 'Closed-cell spray foam', image: assets.serviceImages['closed-cell-spray-foam-insulation'], href: '/future/closed-cell-spray-foam-insulation' },
  { title: 'Roof coatings', image: assets.serviceImages['silicone-roof-coating'], href: '/future/silicone-roof-coating' }
];
---
<section class="future-v1__section future-v1__projects" id="projects" aria-labelledby="future-projects-title">
  <div class="future-v1__section-heading">
    <div><p class="future-v1__kicker">Recent work</p><h2 id="future-projects-title">The work should be easy to see.</h2></div>
    <p>East Coast Foam service photography is shown here without assigning unverified city, date, or project details.</p>
  </div>
  <div class="future-v1__project-grid">
    {work.map((project, index) => <a class={`future-v1__project future-v1__project--${index + 1}`} href={project.href}><img src={project.image} alt={`${project.title} work by East Coast Foam`} loading="lazy" referrerpolicy="no-referrer" /><span><small>East Coast Foam service photography</small><strong>{project.title}</strong><b>Explore service <i aria-hidden="true">→</i></b></span></a>)}
  </div>
  {currentPublicProjects.length === 0 && <p class="future-v1__project-permission-note">Individual project pages, locations, before/during/after sequences, and filters will appear only when project records have approved publication details and website permission.</p>}
  <a class="future-v1__facebook-link" href="https://www.facebook.com/foamit247" target="_blank" rel="noopener noreferrer">See more from East Coast Foam on Facebook <span aria-hidden="true">↗</span></a>
</section>
