---
import site from '../data/site.json';
---
<section class="future-v1__closing" id="service-area" aria-labelledby="future-closing-area-title">
  <div class="future-v1__closing-area">
    <p class="future-v1__kicker">Service area</p>
    <h2 id="future-closing-area-title">South Carolina Lowcountry <em>&amp; Coastal Georgia</em></h2>
    <p>East Coast Foam serves Beaufort, Hilton Head, Bluffton, Charleston, Savannah, and surrounding listed communities.</p>
    <a class="future-v1__text-link" href="/future/service-area">View service area <span aria-hidden="true">→</span></a>
  </div>
  <div class="future-v1__closing-estimate" id="estimate" aria-labelledby="future-closing-estimate-title">
    <p class="future-v1__kicker">Request an estimate</p>
    <h2 id="future-closing-estimate-title">Ready to talk through the project?</h2>
    <p>Start with a call or email. East Coast Foam can help identify the next useful conversation.</p>
    <a class="future-v1__estimate-button" href="/future/estimate">Request an Estimate <span aria-hidden="true">→</span></a>
    <a class="future-v1__closing-call" href={`tel:${site.phoneHref}`}>Call {site.phoneDisplay}</a>
  </div>
</section>
