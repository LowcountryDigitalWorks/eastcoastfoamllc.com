---
import services from '../data/services.json';
import assets from '../data/demo-assets.json';
interface Props { variant?: 'classical' | 'future'; }
const { variant = 'future' } = Astro.props;
const serviceImages = assets.serviceImages as Record<string, string>;
---
<div class={`service-grid service-grid--${variant}`}>
  {services.map((service, index) => (
    <article class="service-card">
      <div class="service-card__image">
        <img src={serviceImages[service.slug]} alt="" loading="lazy" referrerpolicy="no-referrer" />
      </div>
      <span class="service-number">{String(index + 1).padStart(2, '0')}</span>
      <h3>{service.title}</h3>
      <p>{service.summary}</p>
      <a href={variant === 'classical' ? '#quote' : '#estimate'}>
        {variant === 'classical' ? 'Ask about this service' : 'Talk about this project'} <span aria-hidden="true">→</span>
      </a>
    </article>
  ))}
</div>
