---
interface Props { compact?: boolean; showAction?: boolean; }
const { compact = false, showAction = true } = Astro.props;
---
<div class:list={['future-v1__contact-qr', { 'future-v1__contact-qr--compact': compact }]} data-contact-qr>
  <div class="future-v1__contact-qr-code" data-contact-qr-code aria-label="QR code linking to the East Coast Foam contact card download"></div>
  <div><p class="future-v1__kicker">Contact card</p><h2>Save East Coast Foam.</h2><p>Scan to download and save East Coast Foam’s contact card.</p>{showAction && <a href="/future/contact.vcf" download>Download Contact Card <span aria-hidden="true">↓</span></a>}</div>
</div>
<script>
  /** A bundled byte-mode QR encoder (Version 5-L) for the contact-card download. */
  const roots = document.querySelectorAll<HTMLElement>('[data-contact-qr]');
  const EXP = new Uint8Array(512); const LOG = new Uint8Array(256);
  let field = 1;
  for (let index = 0; index < 255; index += 1) { EXP[index] = field; LOG[field] = index; field <<= 1; if (field & 0x100) field ^= 0x11d; }
  for (let index = 255; index < 512; index += 1) EXP[index] = EXP[index - 255];
  const multiply = (left: number, right: number) => !left || !right ? 0 : EXP[LOG[left] + LOG[right]];
  const polynomial = (left: number[], right: number[]) => {
    const output = Array(left.length + right.length - 1).fill(0);
    left.forEach((value, row) => right.forEach((other, column) => output[row + column] ^= multiply(value, other)));
    return output;
  };
  const bch = (value: number, generator: number) => {
    let result = value;
    const degree = (input: number) => Math.floor(Math.log2(input));
    while (degree(result) >= degree(generator)) result ^= generator << (degree(result) - degree(generator));
    return result;
  };
  const contactQr = (text: string) => {
    const bytes = [...new TextEncoder().encode(text)];
    if (bytes.length > 106) return null;
    const payload = [0x40 | (bytes.length >> 4), (bytes.length & 15) << 4];
    bytes.forEach((byte, index) => { if (index % 2 === 0) payload[payload.length - 1] |= byte >> 4; else payload.push((byte & 15) << 4); });
    while (payload.length < 108) payload.push(payload.length % 2 ? 0x11 : 0xec);
    let generator = [1]; for (let index = 0; index < 26; index += 1) generator = polynomial(generator, [1, EXP[index]]);
    const remainder = Array(26).fill(0);
    payload.forEach((byte) => { const factor = byte ^ remainder.shift()!; remainder.push(0); generator.slice(1).forEach((coefficient, index) => remainder[index] ^= multiply(coefficient, factor)); });
    const codewords = [...payload, ...remainder];
    const bits = codewords.flatMap((word) => Array.from({ length: 8 }, (_, bit) => Boolean(word & (1 << (7 - bit)))));
    const size = 37; const matrix: Array<Array<boolean | null>> = Array.from({ length: size }, () => Array(size).fill(null));
    const setFinder = (row: number, column: number) => { for (let y = -1; y <= 7; y += 1) for (let x = -1; x <= 7; x += 1) if (row + y >= 0 && row + y < size && column + x >= 0 && column + x < size) matrix[row + y][column + x] = y >= 0 && y <= 6 && x >= 0 && x <= 6 && (y === 0 || y === 6 || x === 0 || x === 6 || (y >= 2 && y <= 4 && x >= 2 && x <= 4)); };
    setFinder(0, 0); setFinder(size - 7, 0); setFinder(0, size - 7);
    for (let index = 8; index < size - 8; index += 1) { if (matrix[6][index] === null) matrix[6][index] = index % 2 === 0; if (matrix[index][6] === null) matrix[index][6] = index % 2 === 0; }
    for (let y = -2; y <= 2; y += 1) for (let x = -2; x <= 2; x += 1) matrix[30 + y][30 + x] = Math.max(Math.abs(y), Math.abs(x)) === 2 || (x === 0 && y === 0);
    for (let index = 0; index < 15; index += 1) {
      matrix[index < 6 ? index : index < 8 ? index + 1 : size - 15 + index][8] = false;
      matrix[8][index < 8 ? size - index - 1 : index < 9 ? 15 - index : 15 - index - 1] = false;
    }
    matrix[size - 8][8] = false;
    let bitIndex = 0; let row = size - 1; let direction = -1;
    for (let column = size - 1; column > 0; column -= 2) {
      if (column === 6) column -= 1;
      while (true) {
        for (let offset = 0; offset < 2; offset += 1) { const x = column - offset; if (matrix[row][x] === null) { const raw = bits[bitIndex++] || false; matrix[row][x] = raw !== ((row + x) % 2 === 0); } }
        row += direction;
        if (row < 0 || row >= size) { row -= direction; direction = -direction; break; }
      }
    }
    const format = (((8 << 10) | bch(8 << 10, 0x537)) ^ 0x5412);
    for (let index = 0; index < 15; index += 1) {
      const bit = Boolean(format & (1 << index));
      matrix[index < 6 ? index : index < 8 ? index + 1 : size - 15 + index][8] = bit;
      matrix[8][index < 8 ? size - index - 1 : index < 9 ? 15 - index : 15 - index - 1] = bit;
    }
    matrix[size - 8][8] = true;
    return matrix;
  };
  roots.forEach((root) => {
    const target = root.querySelector<HTMLElement>('[data-contact-qr-code]'); if (!target) return;
    const destination = new URL('/future/contact.vcf', window.location.origin).href;
    const matrix = contactQr(destination); if (!matrix) return;
    const namespace = 'http://www.w3.org/2000/svg'; const svg = document.createElementNS(namespace, 'svg');
    svg.setAttribute('viewBox', '0 0 37 37'); svg.setAttribute('role', 'img'); svg.setAttribute('aria-label', 'QR code linking to the East Coast Foam contact card download'); svg.setAttribute('data-contact-qr-svg', '');
    const background = document.createElementNS(namespace, 'rect'); background.setAttribute('width', '37'); background.setAttribute('height', '37'); background.setAttribute('fill', '#fff'); svg.append(background);
    const path = document.createElementNS(namespace, 'path'); let d = '';
    matrix.forEach((line, y) => line.forEach((dark, x) => { if (dark) d += `M${x} ${y}h1v1h-1z`; }));
    path.setAttribute('d', d); path.setAttribute('fill', '#101511'); svg.append(path); target.replaceChildren(svg);
  });
</script>
