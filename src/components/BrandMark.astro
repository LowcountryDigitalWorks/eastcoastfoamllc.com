---
import assets from '../data/demo-assets.json';
interface Props {
  compact?: boolean;
  href?: string;
}
const { compact = false, href = '#top' } = Astro.props;
---
<a class={`brand-mark ${compact ? 'brand-mark--compact' : ''}`} href={href} aria-label="East Coast Foam home">
  <img src={assets.logo} alt="East Coast Foam Insulation" referrerpolicy="no-referrer" />
</a>
