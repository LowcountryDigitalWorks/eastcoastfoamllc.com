---
import assets from '../data/demo-assets.json';
import { futureContact } from '../data/future-content';
---
<section class="future-v1__hero" aria-labelledby="future-hero-title">
  <div class="future-v1__hero-copy">
    <p class="future-v1__kicker">South Carolina Lowcountry &amp; Coastal Georgia</p>
    <h1 id="future-hero-title">Spray Foam &amp; Insulation <em>Built for the Lowcountry</em></h1>
    <p class="future-v1__lede">East Coast Foam helps homeowners, builders, and commercial property owners explore insulation, roof, and coating options for the project in front of them.</p>
    <div class="future-v1__hero-actions" data-mobile-actions-anchor>
      <a class="future-v1__estimate-button" href="/future/estimate">Request an Estimate <span aria-hidden="true">→</span></a>
      <a class="future-v1__call-link" href={`tel:${futureContact.phoneHref}`}>Call East Coast Foam <span aria-hidden="true">↗</span></a>
    </div>
    <a class="future-v1__text-link" href="#projects">See recent work <span aria-hidden="true">↓</span></a>
  </div>
  <div class="future-v1__hero-art" aria-label="East Coast Foam spray foam installation photography">
    <img src={assets.hero} alt="Spray foam insulation installation" fetchpriority="high" referrerpolicy="no-referrer" />
    <div class="future-v1__hero-grid" aria-hidden="true"></div>
    <div class="future-v1__hero-caption"><span>East Coast Foam</span><strong>Real work. Clear next steps.</strong></div>
  </div>
</section>
