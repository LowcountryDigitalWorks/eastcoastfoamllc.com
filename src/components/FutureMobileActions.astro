---
import { futureContact } from '../data/future-content';

interface Props {
  estimatePage?: boolean;
}

const { estimatePage = false } = Astro.props;
---
{!estimatePage && <div class="future-v1__mobile-actions" data-hidden role="region" aria-label="Contact East Coast Foam">
  <a href={`tel:${futureContact.phoneHref}`}><span class="future-v1__action-icon" aria-hidden="true">☎</span> Call</a>
  <a href="/future/estimate">Request Estimate</a>
</div>}

<script>
  const actions = document.querySelector<HTMLElement>('.future-v1__mobile-actions');
  const estimate = document.querySelector('#estimate');
  const anchor = document.querySelector('[data-mobile-actions-anchor]');
  const header = document.querySelector<HTMLElement>('.future-v1__header');

  if (actions && 'IntersectionObserver' in window) {
    let pastAnchor = !anchor;
    let nearEstimate = false;
    const setVisibility = () => actions.toggleAttribute('data-hidden', !pastAnchor || nearEstimate);
    const observer = new IntersectionObserver(([entry]) => {
      nearEstimate = entry.isIntersecting;
      setVisibility();
    }, { threshold: 0.08, rootMargin: '0px 0px -16% 0px' });
    if (estimate) observer.observe(estimate);
    let frame = 0;
    const updateAnchorVisibility = () => {
      frame = 0;
      if (anchor instanceof HTMLElement) {
        const headerBottom = header?.getBoundingClientRect().bottom ?? 0;
        // Show the floating controls once the actual hero/page conversion controls
        // are no longer reasonably reachable, rather than after a fixed scroll.
        pastAnchor = anchor.getBoundingClientRect().bottom <= headerBottom + 12;
      }
      setVisibility();
    };
    const scheduleAnchorUpdate = () => { if (!frame) frame = requestAnimationFrame(updateAnchorVisibility); };
    window.addEventListener('scroll', scheduleAnchorUpdate, { passive: true });
    window.addEventListener('resize', scheduleAnchorUpdate);
    scheduleAnchorUpdate();
  }
</script>
