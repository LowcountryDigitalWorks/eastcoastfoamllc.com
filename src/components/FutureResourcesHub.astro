    <a id="foam-types" href="/future/open-cell-spray-foam-insulation"><img src={assets.blogImages[3]} alt="Open-cell spray foam installation" loading="lazy" referrerpolicy="no-referrer" /><span><small>Foam types</small>Open-cell spray foam overview <b aria-hidden="true">→</b></span></a>
    <a href="/future/closed-cell-spray-foam-insulation"><img src={assets.blogImages[0]} alt="Closed-cell spray foam insulation" loading="lazy" referrerpolicy="no-referrer" /><span><small>Foam types</small>Closed-cell spray foam overview <b aria-hidden="true">→</b></span></a>
