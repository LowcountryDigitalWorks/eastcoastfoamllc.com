---
import BrandMark from './BrandMark.astro';
import site from '../data/site.json';
import assets from '../data/demo-assets.json';
import services from '../data/services.json';
---
<div class="classical-topbar">
  <div>
    <a href={`tel:${site.phoneHref}`}><span class="classical-contact-icon" aria-hidden="true">☎</span> {site.phoneDisplay}</a>
    <a href={`mailto:${site.publicEmail}`}><span class="classical-contact-icon" aria-hidden="true">✉</span> {site.publicEmail}</a>
  </div>
  <div class="classical-topbar__reviews">
    <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" aria-label="East Coast Foam on Google Maps">
      <img src={assets.googleReviewsBadge} alt="Google Reviews" referrerpolicy="no-referrer" />
    </a>
    <a class="classical-topbar__facebook" href={site.facebook} target="_blank" rel="noopener noreferrer" aria-label="East Coast Foam on Facebook">f</a>
  </div>
</div>
<header class="classical-header">
  <BrandMark href="/classical" />
  <nav aria-label="East Coast Foam navigation">
    <a href="/classical">Home</a>
    <a href="/classical/about-us">About Us</a>
    <div class="classical-nav-dropdown">
      <a href="/classical/services" aria-haspopup="true">Services <span aria-hidden="true">⌄</span></a>
      <div class="classical-nav-dropdown__menu">
        {services.map((service) => <a href={`/classical/${service.slug}`}>{service.title}</a>)}
      </div>
    </div>
    <a href="/classical/blog">Blog</a>
    <a href="/classical/contact-us">Contact Us</a>
  </nav>
  <a class="classical-quote-button" href="/classical/get-a-quote">Get a Quote</a>
</header>
