---
import assets from '../data/demo-assets.json';
---
<section class="future-v1__work-proof" id="projects" aria-labelledby="future-work-proof-title">
  <div class="future-v1__work-proof-copy">
    <p class="future-v1__kicker">Recent work</p>
    <h2 id="future-work-proof-title">Real equipment. Real jobsite perspective.</h2>
    <p>Explore East Coast Foam service photography alongside the truck and trailer customers recognize on the road and at the jobsite.</p>
    <div class="future-v1__work-proof-links"><a href="/future/projects">See recent work <span aria-hidden="true">→</span></a><a href="/future/about">Meet East Coast Foam <span aria-hidden="true">→</span></a></div>
  </div>
  <div class="future-v1__work-proof-media">
    <figure class="future-v1__work-proof-vehicle"><img src={assets.companyVehicle} alt="East Coast Foam truck and branded insulation trailer" loading="lazy" referrerpolicy="no-referrer" /><figcaption>East Coast Foam on the road and at the jobsite.</figcaption></figure>
    <figure><img src={assets.serviceImages['open-cell-spray-foam-insulation']} alt="East Coast Foam spray foam installation work" loading="lazy" referrerpolicy="no-referrer" /></figure>
  </div>
</section>
