---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClassicalHeader from '../../components/ClassicalHeader.astro';
import ClassicalFooter from '../../components/ClassicalFooter.astro';
import ClassicalEstimateForm from '../../components/ClassicalEstimateForm.astro';
import ClassicalServiceAreaMap from '../../components/ClassicalServiceAreaMap.astro';
import site from '../../data/site.json';
import assets from '../../data/demo-assets.json';
---
<BaseLayout title={`Contact Us | ${site.name}`} description="Contact East Coast Foam LLC for spray foam insulation and related services in Beaufort County, Charleston County, and surrounding Lowcountry communities." theme="classical" showDemoBanner={false}>
  <div id="top" class="classical-site">
    <ClassicalHeader />
    <main>
      <section class="classical-page-hero">
        <img src={assets.serviceImages['fiberglass-batt-insulation']} alt="" referrerpolicy="no-referrer" />
        <div class="classical-page-hero__inner"><p class="classical-overline">East Coast Foam LLC</p><h1>Contact Us</h1></div>
      </section>
      <section class="classical-contact-page">
        <div class="classical-contact-page__form"><ClassicalEstimateForm /></div>
        <div class="classical-contact-page__details">
          <p class="classical-overline">Get in touch</p>
          <h2>Talk with East Coast Foam about your project.</h2>
          <dl>
            <div><dt>Email Address</dt><dd><a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a></dd></div>
            <div><dt>Phone Number</dt><dd><a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a></dd></div>
            <div><dt>Address</dt><dd><a href={site.mapsUrl} target="_blank" rel="noopener noreferrer">{site.address}</a></dd></div>
            <div><dt>Business Hours</dt><dd>{site.hours}</dd></div>
          </dl>
          <h3>Areas We Serve</h3>
          <div class="classical-area-list">{site.serviceAreas.map((area) => <span>{area}</span>)}</div>
        </div>
      </section>
      <ClassicalServiceAreaMap />
    </main>
    <ClassicalFooter />
  </div>
</BaseLayout>
