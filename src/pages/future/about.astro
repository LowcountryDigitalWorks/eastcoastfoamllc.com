---
import FutureLayout from '../../layouts/FutureLayout.astro';
import FutureAbout from '../../components/FutureAbout.astro';
import FuturePageIntro from '../../components/FuturePageIntro.astro';
import assets from '../../data/demo-assets.json';
import { manufacturerLinks } from '../../data/future-content';

const brandLogos = assets.brandLogos as Record<string, string>;
---
<FutureLayout title="About East Coast Foam" description="Learn about East Coast Foam, its local service focus, and manufacturer materials connected to its service conversations.">
  <FuturePageIntro eyebrow="About East Coast Foam" title="Local expertise. Direct accountability." text="East Coast Foam serves homeowners, builders, and property owners across the Lowcountry and Coastal Georgia with insulation, roofing, and coating conversations grounded in the project." />
  <FutureAbout />
  <section class="future-v1__founder-sample" aria-labelledby="future-founder-sample-title">
    <div class="future-v1__founder-sample-portrait" aria-label="Casey founder portrait placeholder"><span>CASEY</span><small>Founder portrait placeholder</small><i></i></div>
    <div><p class="future-v1__kicker">Sample founder story</p><h2 id="future-founder-sample-title">Straight answers, careful preparation, and respect for the property.</h2><p><strong>SAMPLE STORY — replace with Casey’s real history after owner interview.</strong></p><p>East Coast Foam is built around straightforward recommendations, careful preparation, and doing the work with respect for the property. The goal is to help homeowners, builders, and property owners understand the options in front of them and choose an insulation or coating approach that fits the project—not simply sell the most expensive material.</p><p>Every project starts by looking at the accessible conditions, the space being considered, and the outcome the customer is trying to achieve. This is sample design copy only; Casey’s real background, history, and words will replace it after the owner interview.</p><span class="future-v1__sample-note">SAMPLE / DESIGN COPY · Founder facts and portrait only after owner approval.</span></div>
  </section>
  <section class="future-v1__section future-v1__partners" aria-labelledby="future-partners-title">
    <div class="future-v1__section-heading"><div><p class="future-v1__kicker">Materials represented</p><h2 id="future-partners-title">Material options for the work in front of you.</h2></div><p>These marks link to their public manufacturer sources. Product selection remains specific to the property and project.</p></div>
    <div class="future-v1__partner-grid">{manufacturerLinks.map((brand) => <a href={brand.url} target="_blank" rel="noopener noreferrer"><img src={brandLogos[brand.name]} alt={brand.name} loading="lazy" referrerpolicy="no-referrer" /><span>{brand.name}</span></a>)}</div>
  </section>
</FutureLayout>
