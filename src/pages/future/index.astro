---
import FutureClosing from '../../components/FutureClosing.astro';
import FutureHero from '../../components/FutureHero.astro';
import FutureProofStrip from '../../components/FutureProofStrip.astro';
import FutureServicesOverview from '../../components/FutureServicesOverview.astro';
import FutureWorkProof from '../../components/FutureWorkProof.astro';
import FutureLayout from '../../layouts/FutureLayout.astro';
import GoogleReviewsCarousel from '../../components/GoogleReviewsCarousel.astro';
---
<FutureLayout title={`East Coast Foam | Spray Foam & Insulation for the Lowcountry`} description="Explore East Coast Foam spray foam, insulation, roofing, and coating services for the South Carolina Lowcountry and Coastal Georgia.">
  <FutureHero />
  <FutureProofStrip />
  <FutureServicesOverview />
  <FutureWorkProof />
  <section class="future-v1__section future-v1__reviews future-v1__reviews--home" id="reviews" aria-labelledby="future-reviews-title">
    <div class="future-v1__section-heading"><div><p class="future-v1__kicker">Customer reviews</p><h2 id="future-reviews-title">Customer feedback, in their own words.</h2></div><p>Read current public feedback, then explore the independent profile sources that help customers evaluate a contractor.</p></div>
    <GoogleReviewsCarousel compact limit={2} />
    <a class="future-v1__section-route" href="/future/reviews">Read customer reviews <span aria-hidden="true">→</span></a>
  </section>
  <FutureClosing />
</FutureLayout>
