---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FutureAbout from '../../components/FutureAbout.astro';
import FutureEstimate from '../../components/FutureEstimate.astro';
import FutureFoamTeaser from '../../components/FutureFoamTeaser.astro';
import FutureFooter from '../../components/FutureFooter.astro';
import FutureHeader from '../../components/FutureHeader.astro';
import FutureHero from '../../components/FutureHero.astro';
import FutureMobileActions from '../../components/FutureMobileActions.astro';
import FutureProcess from '../../components/FutureProcess.astro';
import FutureProjectPaths from '../../components/FutureProjectPaths.astro';
import FutureProjects from '../../components/FutureProjects.astro';
import FutureProofStrip from '../../components/FutureProofStrip.astro';
import FutureResources from '../../components/FutureResources.astro';
import FutureServiceArea from '../../components/FutureServiceArea.astro';
import FutureServices from '../../components/FutureServices.astro';
import GoogleReviewsCarousel from '../../components/GoogleReviewsCarousel.astro';
import site from '../../data/site.json';
---
<BaseLayout title={`Future | ${site.name}`} description="East Coast Foam spray foam, insulation, roofing, and coating services for the South Carolina Lowcountry and Coastal Georgia." theme="future">
  <div id="top" class="future-v1">
    <FutureHeader />
    <main>
      <FutureHero />
      <FutureProofStrip />
      <FutureProjectPaths />
      <FutureServices />
      <FutureFoamTeaser />
      <FutureProjects />
      <FutureAbout />
      <section class="future-v1__section future-v1__reviews" id="reviews" aria-labelledby="future-reviews-title">
        <div class="future-v1__section-heading"><div><p class="future-v1__kicker">Customer reviews</p><h2 id="future-reviews-title">Hear from East Coast Foam customers.</h2></div><p>Read the customer feedback already shared on Google.</p></div>
        <GoogleReviewsCarousel />
      </section>
      <FutureProcess />
      <FutureServiceArea />
      <FutureResources />
      <FutureEstimate />
    </main>
    <FutureFooter />
    <FutureMobileActions />
  </div>
</BaseLayout>
