---
import FutureLayout from '../../layouts/FutureLayout.astro';
import FuturePageIntro from '../../components/FuturePageIntro.astro';
import GoogleReviewsCarousel from '../../components/GoogleReviewsCarousel.astro';
import { futureReputationSources } from '../../data/future-content';
---
<FutureLayout title="Customer Reviews | East Coast Foam" description="Read the East Coast Foam customer feedback currently shared through Google reviews.">
  <FuturePageIntro eyebrow="Customer reviews" title="Customer feedback, in their own words." text="Read the customer feedback currently shared through Google, then explore the relevant public reputation profiles." />
  <section class="future-v1__section future-v1__reviews future-v1__reviews--page" aria-label="East Coast Foam customer reviews"><GoogleReviewsCarousel /><div class="future-v1__reputation-links" aria-label="Public reputation profiles">{futureReputationSources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer"><span>{source.label}</span><strong>{source.detail}</strong><b aria-hidden="true">↗</b></a>)}</div></section>
</FutureLayout>
