---
import FutureContactQr from '../../components/FutureContactQr.astro';
import FutureLayout from '../../layouts/FutureLayout.astro';
import FuturePageIntro from '../../components/FuturePageIntro.astro';
import { futureContact } from '../../data/future-content';
---
<FutureLayout title="Contact East Coast Foam" description="Call, email, map, or save East Coast Foam contact information for insulation, roofing, and coating conversations.">
  <FuturePageIntro eyebrow="Contact" title="Keep East Coast Foam close to the project." text="Call, email, or save the contact details for the next insulation, roofing, or coating conversation." />
  <section class="future-v1__contact-grid" aria-label="East Coast Foam contact information"><div><p class="future-v1__kicker">Contact East Coast Foam</p><a class="future-v1__contact-line" href={`tel:${futureContact.phoneHref}`}><span aria-hidden="true">☎</span>{futureContact.phoneDisplay}</a><a class="future-v1__contact-line" href={`mailto:${futureContact.publicEmail}`}><span aria-hidden="true">✉</span>{futureContact.publicEmail}</a><a class="future-v1__contact-line" href={futureContact.mapsUrl} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">⌖</span>{futureContact.address}</a><p>{futureContact.hours}</p><a class="future-v1__contact-card-button" href="/future/contact.vcf" download><span aria-hidden="true">↓</span> Download Contact Card</a><p class="future-v1__contact-card-help">Tap to download East Coast Foam’s contact card. When the download finishes, open the file and choose Add to Contacts.</p></div><FutureContactQr showAction={false} /></section>
</FutureLayout>
