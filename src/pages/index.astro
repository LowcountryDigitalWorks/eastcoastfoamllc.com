---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
---
<BaseLayout title="East Coast Foam — Website Directions" description="Compare two possible website directions for East Coast Foam.">
  <main class="chooser" id="top">
    <div class="chooser__inner">
      <div class="chooser__brand"><BrandMark /></div>
      <p class="eyebrow">Lowcountry Digital Works · website direction review</p>
      <h1>Two directions for East Coast Foam.</h1>
      <p class="chooser__intro">Compare a familiar Classical experience with a more ambitious Future direction.</p>
      <div class="chooser-grid">
        <a class="chooser-card chooser-card--classical" href="/classical" target="_blank" rel="noopener noreferrer">
          <span>01</span>
          <h2>Classical</h2>
          <p>A familiar experience based closely on East Coast Foam's current website.</p>
          <strong>Open Classical in new tab →</strong>
        </a>
        <a class="chooser-card chooser-card--future" href="/future" target="_blank" rel="noopener noreferrer">
          <span>02</span>
          <h2>Future</h2>
          <p>A redesigned experience showing what the next generation of East Coast Foam could look like.</p>
          <strong>Open Future in new tab →</strong>
        </a>
      </div>
      <p class="chooser-footnote">Each direction opens in a new tab for easy side-by-side comparison.</p>
    </div>
  </main>
</BaseLayout>
